{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=devflow;Username=devflow;Password=devflow",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "devflow-api",
    "Audience": "devflow-client",
    "Key": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "OAuth": {
    "GoogleClientId": "448611401710-47cv8jf3ej9nmafuk8lerum671vkhlg9.apps.googleusercontent.com",
    "GoogleClientSecret": "",
    "GoogleRedirectUri": "https://devflow-platform-kappa.vercel.app/login"
  },
  "Ai": {
    "Provider": "gemini",
    "ApiKey": "",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-2.0-flash",
    "MaxTokens": 4000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4173",
      "https://devflow-platform-smoky.vercel.app",
      "https://devflow-platform-kappa.vercel.app"
    ]
  },
"RateLimiting": {
      "Enabled": true,
      "PermitLimit": 200,
      "AuthenticatedPermitLimit": 800,
      "WindowSeconds": 60,
      "QueueLimit": 20
    },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/devflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
