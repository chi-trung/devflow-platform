# Copy this file to .env and adjust the values.
# docker compose automatically loads variables from .env.
#
# DevFlow has three run targets, each with its own variable home:
#   1. docker compose (this file)  — local Postgres + Redis + API
#   2. Backend API  (src/DevFlow.Api) — reads the Jwt/OAuth/Ai sections of
#      appsettings.json, every one of which can be overridden by an
#      environment variable of the shape  Jwt__Key, OAuth__GoogleClientId, …
#      (double underscore = section nesting). On Render these live in the
#      dashboard's Environment settings, not in a file.
#   3. Frontend     (frontend/) — reads VITE_* variables at build time; on
#      Vercel they live in Project → Settings → Environment Variables.

# ── Docker compose: infrastructure ─────────────────────────────────────
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_DB=devflow

# ── Backend API (override appsettings.json sections with __ notation) ──
# Jwt signing key — REQUIRED in production, generate with:
#   openssl rand -base64 64
Jwt__Key=
Jwt__Issuer=devflow-api
Jwt__Audience=devflow-client
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# Google OAuth (GoogleCloud console → Credentials). The client id is a
# public identifier and safe to expose; the client secret must never be
# committed. Leave GoogleClientSecret empty to disable Google sign-in.
OAuth__GoogleClientId=
OAuth__GoogleClientSecret=
OAuth__GoogleRedirectUri=https://localhost:3000/login

# GitHub OAuth (github.com/settings/developers → OAuth Apps). Leave
# GitHubClientSecret empty to disable GitHub sign-in.
OAuth__GitHubClientId=
OAuth__GitHubClientSecret=
OAuth__GitHubRedirectUri=https://localhost:3000/login

# Gemini AI (used by the AI planner + RAG embeddings). Empty = AI features
# disabled (NoOp client; knowledge retrieval falls back to weight order).
Ai__ApiKey=
Ai__Model=gemini-2.5-flash
# Optional RAG knobs (defaults shown; empty EmbeddingModel = provider default:
# gemini → text-embedding-004, openai → text-embedding-3-small with dimensions=768).
# Ai__EmbeddingModel=
# Ai__EmbeddingDimensions=768
# Ai__EnableRerank=false
# Ai__RetrieveTopK=12
# Ai__KnowledgeCharBudget=3500

# ── Frontend (VITE_*, baked at build time — set before `npm run build`) ─
# Base URL of the DevFlow API, no trailing slash. Empty = same-origin.
VITE_API_URL=

# ── Email (not sectioned — read as top-level keys) ──────────────────────
# Registration is gated on proving the address, so these decide whether the
# feature works at all. Unlike a no-op mail call, a missing key is loud: the
# API logs a warning at startup naming whatever is missing.
#
# RESEND_API_KEY — https://resend.com/api-keys. Empty = no provider: the
#   verification link is written to the backend log instead of being mailed,
#   so local testing works with no account at all.
RESEND_API_KEY=
# RESEND_FROM_EMAIL — must be on a domain you verified in Resend, or every
#   send is rejected with a validation error. The free tier only allows
#   sending to the address you signed up with.
RESEND_FROM_EMAIL=DevFlow <noreply@resend.dev>
# FRONTEND_URL — where the verification link points. The `npm run dev` port,
#   no trailing slash. Get this wrong in production and the link sends
#   everyone to localhost with no visible error anywhere.
FRONTEND_URL=http://localhost:3000
