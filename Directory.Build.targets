<Project>

  <!-- Microsoft.Extensions.Hosting 10 / EF Core 9 flow out-of-band
       System.Text.Json / Encodings.Web / IO.Pipelines into DevFlow.Api
       (Web SDK). A plain (non-Web) SDK test project otherwise binds the
       in-box net8.0 facades and fails with MSB3277/CS1705 assembly-version
       splits, or NU1605 when a stale pin sits below a transitive 10.0.12
       floor (TreatWarningsAsErrors turns NU1605 fatal). Pinning the
       out-of-band packages here raises the test projects onto the same
       copies and unifies the graph.
       Kept in one place instead of per-csproj so both test projects stay in
       step if a third is added. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.12" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.12" />
  </ItemGroup>

</Project>
